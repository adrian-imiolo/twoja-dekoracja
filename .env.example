# Copy to .env.local and fill in. See README.md → Environment.
#
# Both of these are required in a deployment and optional locally: without them
# the contact form writes the inquiry to the server log instead of sending it,
# which is what lets the end-to-end suite run with no key and no network.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Sender address. Resend only sends from a domain verified in the account, so
# this stays on Resend's shared sender until the custom domain is verified.
# CONTACT_FROM_EMAIL="Twoja Dekoracja <onboarding@resend.dev>"

# The origin canonicals and link previews are resolved against. Required in a
# deployment; defaults to http://localhost:3000 otherwise.
# NEXT_PUBLIC_SITE_URL=
